# Server porti
PORT=5000

# MongoDB manzili (lokal yoki MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/sardoba

# JWT token uchun maxfiy kalit (o'zgartiring!)
JWT_SECRET=bu_yerga_uzun_maxfiy_kalit_yozing
JWT_EXPIRES_IN=7d

# Frontend manzili (CORS uchun), vergul bilan bir nechta yozish mumkin
CLIENT_URL=http://localhost:5173

# Vaqt zonasi (Toshkent = +05:00)
TZ_OFFSET=+05:00

# Mahsulot "kam qoldi" deb hisoblanadigan standart chegara
LOW_STOCK_DEFAULT=15
